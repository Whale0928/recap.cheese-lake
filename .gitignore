# API 의존성과 빌드 산출물
api/node_modules/
api/dist/
api/coverage/

# 로컬 설정 · 시크릿
# orca-setup.sh 의 SECRET_FILES 와 동기화할 것
.env
.env.*
!.env.example
!**/.env.example
*.local.yaml

# 프론트엔드
# 스택 확정 전이라 후보 산출물을 함께 막아둔다 (ADR-0004)
ui/node_modules/
ui/dist/
ui/.next/
ui/.svelte-kit/
.pnpm-store/
*.tsbuildinfo

# 도구 · 에디터
.task/
.DS_Store
.idea/
.vscode/
*.swp
.claude/
.playwright-mcp/

# 작업 중 흘린 것 — 스크린샷·덤프는 저장소에 남기지 않는다
*.png
*.jpg
*.jpeg
*.gif
*.webp
!docs/**/*.png
!docs/**/*.svg
# 브랜드 아이콘은 흘린 것이 아니라 자산이다
!ui/assets/*.png
!ui/assets/images/kindaichi_notice.png

# 서브모듈 내부는 각자 관리
# module.platform, module.secrets, module.deploy 는 gitlink 로만 추적된다

# 디자인 캔버스 시딩 산출물 — 작업 파일(.dc.html · canvas.json)에서 다시 만든다
.design/**/recap-component-catalog.html
