RECAP_CHZZK_CLIENT_ID=
RECAP_CHZZK_CLIENT_SECRET=
RECAP_CHZZK_REDIRECT_URI=http://localhost:8180/auth/callback
RECAP_SESSION_KEY=
# 세션 키는 openssl rand -hex 32로 생성한다.
PORT=8180
# UI 개발 서버를 사용할 때는 http://localhost:5273/로 지정한다.
RECAP_LOGIN_SUCCESS_URL=http://localhost:8180/

# 배포에서는 인증된 Redis 세션 저장소가 필수다. 로컬 개발에서는 생략할 수 있다.
# RECAP_REDIS_HOST=127.0.0.1
# RECAP_REDIS_PORT=6379
# RECAP_REDIS_PASSWORD=
# TCP 접속자 기준이며 X-Forwarded-For는 허용 판정에 사용하지 않는다.
RECAP_ALLOWED_CIDRS=127.0.0.1/32,::1/128
RECAP_CORS_ORIGINS=http://localhost:8180,http://127.0.0.1:8180,http://localhost:5273,http://127.0.0.1:5273
